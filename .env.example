# OpenRouter API key — get one at https://openrouter.ai/keys
# Server-side only. Never exposed to the browser.
OPENROUTER_API_KEY=

# Optional attribution headers (shown on openrouter.ai activity)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Content Maker

# fal.ai API key — https://fal.ai/dashboard/keys  (image/video "(FAL)" models)
FAL_API_KEY=

# WaveSpeed API key — https://wavespeed.ai  (text/image/video "(WS)" models)
WAVESPEED_API_KEY=

# --- trend → topic providers (optional; only set the ones you use) ---
# YOUTUBE_API_KEY=        # YouTube Data API v3 (free) — trending by region
# NEWS_API_KEY=           # NewsAPI/GNews (free tier) — headlines by keyword/country
# SERPAPI_KEY=            # SerpApi Google Trends (paid) — rising/breakout queries

# --- ad maker (/ad) ---
# Narration(TTS) + BGM each auto-pick a provider from whichever key below is set.
# ELEVENLABS_API_KEY=     # VO TTS via ElevenLabs — https://elevenlabs.io
# ELEVENLABS_VOICE_ID=    # optional; default "Sarah"(free-tier OK) — library voices need a paid plan
# GEMINI_API_KEY=         # Google AI Studio key — https://aistudio.google.com/apikey
#                         #   enables Gemini TTS (narration) AND Gemini Lyria (BGM) with one key
# GEMINI_TTS_VOICE=       # optional; default "Kore" (Gemini prebuilt voice; ko supported)
# GEMINI_TTS_MODEL=       # optional; default gemini-2.5-flash-preview-tts
# GEMINI_MUSIC_MODEL=     # optional; default lyria-3-clip-preview (rename here if Google changes it)
# AD_TTS_PROVIDER=        # optional; "elevenlabs" | "gemini" (blank = auto: use whichever key is set)
# AD_MUSIC_PROVIDER=      # optional; "fal" | "gemini" (blank = auto)
# AD_COMPOSE_MODEL=       # optional; default openai/gpt-4.1 (via OpenRouter)
# AD_MUSIC_MODEL=         # optional; default fal-ai/stable-audio (fal BGM — needs FAL_API_KEY)

# Rendering uses Remotion (bundles its own ffmpeg) — no system ffmpeg/ffprobe needed.
