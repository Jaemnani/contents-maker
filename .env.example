# OpenRouter API key — get one at https://openrouter.ai/keys
# Server-side only. Never exposed to the browser.
OPENROUTER_API_KEY=

# Optional attribution headers (shown on openrouter.ai activity)
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_SITE_NAME=Content Maker

# fal.ai API key — https://fal.ai/dashboard/keys  (image/video "(FAL)" models)
FAL_API_KEY=

# WaveSpeed API key — https://wavespeed.ai  (text/image/video "(WS)" models)
WAVESPEED_API_KEY=

# --- post-processing (comparison shorts; all local, no API cost) ---
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   # default: ffmpeg on PATH
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
# BGM_PATH=assets/bgm/track.mp3          # drop a royalty-free track here to enable BGM
# BRAND_TEXT=aibtown.com                 # outro card brand/CTA
